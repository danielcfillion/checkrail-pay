# ---- Modes (the app runs fully with these defaults and zero credentials) ----
RAIL_MODE=mock          # mock | live   (live = PayPal sandbox + Stellar testnet)
AI_MODE=mock            # mock | live   (live = Anthropic API)
DATABASE_PATH=./data/dueline.sqlite

# ---- Access control (optional) ----
# Set to user:pass to require HTTP Basic auth on every page and action. The username
# becomes the audit actor (user:<name>). One shared credential, not RBAC. Leave unset for
# the zero-credential demo. The PayPal webhook route is exempt (it verifies PayPal's signature).
# Do not run RAIL_MODE=live without this, or without a proxy that authenticates users.
DUELINE_BASIC_AUTH=

# ---- PayPal (sandbox) ----
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
DEMO_PAYPAL_RECIPIENT=     # sandbox Personal account email; the demo vendor Maria is paid here in live mode

# ---- Stellar (testnet) ----
# STELLAR_RAIL=mock         # optional: keep Stellar simulated while testing PayPal alone. Delete once the testnet wallet exists.
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_TREASURY_SECRET=
STELLAR_PYUSD_ISSUER=GBT2KJDKUZYZTQPCSR57VZT5NJHI4H7FOB5LT5FPRWSR7I5B4FS3UU7G
STELLAR_PYUSD_CODE=PYUSD
DEMO_STELLAR_RECIPIENT=   # funded testnet account with a PYUSD trustline, from scripts/stellar-setup.ts

# ---- AI ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Accounting ----
ACCOUNTING_DESTINATION=csv   # csv | xero
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Autopilot heartbeat: one pass every N seconds inside the server (default 15). Set to off and
# call POST /api/autopilot/tick from a scheduler if you run more than one server process.
# AUTOPILOT_HEARTBEAT=off
# AUTOPILOT_HEARTBEAT_SECONDS=15
