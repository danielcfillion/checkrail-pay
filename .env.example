# ---- Modes (the app runs fully with these defaults and zero credentials) ----
RAIL_MODE=mock          # mock | live   (live = PayPal sandbox + Stellar testnet)
AI_MODE=mock            # mock | live   (live = Anthropic API)
DATABASE_PATH=./data/checkrail-pay.sqlite

# ---- Access control ----
# Named logins with roles (admin, approver, clerk, accountant), comma separated. The username becomes the audit
# actor (user:<name>). Approvers get a default limit of 1,000.00 in base currency; the owner edits limits, cover
# while away, and access in Settings, Team. Passwords may not contain ":" or ",".
#   CHECKRAIL_USERS=daniel:<pw>:admin,minh:<pw>:approver,lan:<pw>:clerk,thu:<pw>:accountant
CHECKRAIL_USERS=
# Older single login, treated as admin. Ignored when CHECKRAIL_USERS is set.
CHECKRAIL_BASIC_AUTH=
# With no logins configured the app only opens in development, or when you explicitly accept an open demo
# (never with RAIL_MODE=live). Anything else answers 503 instead of running unauthenticated.
CHECKRAIL_INSECURE_DEMO=
# 1 = show the "Demo: act as" switch so one login can play the owner, the approver, the clerk and the accountant.
# Ignored whenever real money can move.
CHECKRAIL_DEMO_PERSONAS=
# For an external scheduler: POST /api/autopilot/tick with Authorization: Bearer <this>. Required with live rails.
CHECKRAIL_TICK_TOKEN=
# Dates and "today" on screen are shown in this zone.
NEXT_PUBLIC_CHECKRAIL_TIMEZONE=Asia/Ho_Chi_Minh

# 1 = show the tax tools: Vietnamese PIT and Philippine EWT withholding switches in Settings, and the US 1099-NEC
# panel on Books. Off by default (the hosted demo keeps them hidden). Withholding already saved in a business's
# policy keeps applying whether or not the controls are shown.
CHECKRAIL_TAX_FEATURES=

# ---- Local currency and bank payouts ----
# Invoices can be in USD, VND, PHP or THB. Limits and caps are checked in the base currency at reference rates.
FX_RATES=                 # optional JSON, units per USD, e.g. {"VND":25450,"PHP":57.9,"THB":33.4}
FX_RATES_AS_OF=
# Full bank account numbers (needed by Wise and the bank file) are encrypted with this key: 32 bytes, base64 or hex.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required with any live rail (sandbox and testnet included) and on any production server that is not the
# simulated demo. Only a dev server or the simulated hosted demo may fall back to the public development key.
CHECKRAIL_DATA_KEY=
# Wise Business (local bank payouts). Leave empty to show Wise as not connected. WISE_RAIL=mock simulates it.
WISE_API_TOKEN=
WISE_PROFILE_ID=
WISE_ENV=sandbox
# Vietnamese company account that bulk-payment files pay from. Unset: no VND bank file route.
BANK_FILE_SOURCE_ACCOUNT=

# ---- Xero bills file ----
XERO_TAX_TYPE=Tax Exempt          # tax type on each bill line, as your Xero region names it
XERO_TRACKING_NAME=Departure      # tracking category name; the option is the departure code

# ---- Mock balances (payment run funding check, mock rails only) ----
MOCK_PAYPAL_BALANCE_USD=3000
MOCK_STELLAR_BALANCE_USD=2000

# ---- PayPal (sandbox) ----
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
DEMO_PAYPAL_RECIPIENT=     # sandbox Personal account email; the demo vendor Maria is paid here in live mode
DEMO_PAYPAL_RECIPIENT_ROSA= # a second sandbox Personal account for Rosa, so two vendors do not share one payout address

# ---- Stellar (testnet) ----
# STELLAR_RAIL=mock         # optional: keep Stellar simulated while testing PayPal alone. Delete once the testnet wallet exists.
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_TREASURY_SECRET=
STELLAR_PYUSD_ISSUER=GBT2KJDKUZYZTQPCSR57VZT5NJHI4H7FOB5LT5FPRWSR7I5B4FS3UU7G
STELLAR_PYUSD_CODE=PYUSD
DEMO_STELLAR_RECIPIENT=   # funded testnet account with a PYUSD trustline, from scripts/stellar-setup.ts

# ---- AI ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Accounting ----
ACCOUNTING_DESTINATION=csv   # csv | xero
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Autopilot heartbeat: one pass every N seconds inside the server (default 15). Set to off and
# call POST /api/autopilot/tick from a scheduler if you run more than one server process.
# AUTOPILOT_HEARTBEAT=off
# AUTOPILOT_HEARTBEAT_SECONDS=15
